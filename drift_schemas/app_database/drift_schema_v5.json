  "fixed_sql": [
    {
      "name": "gardens",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gardens\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"space_type\" TEXT NOT NULL, \"city_name\" TEXT NULL, \"region\" TEXT NULL, \"length_cm\" REAL NULL, \"width_cm\" REAL NULL, \"sun\" TEXT NOT NULL, \"facing\" TEXT NOT NULL, \"wind\" TEXT NOT NULL, \"water\" TEXT NOT NULL, \"goals\" TEXT NOT NULL DEFAULT '', \"style\" TEXT NULL, \"experience\" TEXT NULL, \"weekly_time\" TEXT NOT NULL, \"budget\" TEXT NOT NULL, \"cover_photo_id\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "garden_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"garden_photos\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"relative_path\" TEXT NOT NULL, \"thumbnail_path\" TEXT NOT NULL, \"caption\" TEXT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"taken_at\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "layout_elements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"layout_elements\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"center_x\" REAL NOT NULL, \"center_y\" REAL NOT NULL, \"width\" REAL NOT NULL, \"height\" REAL NOT NULL, \"rotation_deg\" REAL NOT NULL DEFAULT 0.0, \"depth_cm\" REAL NULL, \"label\" TEXT NULL, \"z_index\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plantings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plantings\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"species_id\" TEXT NOT NULL, \"element_id\" TEXT NULL, \"quantity\" INTEGER NOT NULL, \"planted_on\" TEXT NOT NULL, \"started_from\" TEXT NOT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shortlist_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shortlist_entries\" (\"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"species_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"garden_id\", \"species_id\"));"
        }
      ]
    },
    {
      "name": "care_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"care_rules\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"planting_id\" TEXT NOT NULL REFERENCES plantings (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"days\" INTEGER NULL, \"start_on\" TEXT NOT NULL, \"weekdays\" TEXT NULL, \"month\" INTEGER NULL, \"day\" INTEGER NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_on\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "care_tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"care_tasks\" (\"id\" TEXT NOT NULL, \"rule_id\" TEXT NOT NULL REFERENCES care_rules (id) ON DELETE CASCADE, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"planting_id\" TEXT NOT NULL REFERENCES plantings (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"due_on\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"completed_on\" TEXT NULL, \"note\" TEXT NULL, \"skip_reason\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"rule_id\", \"due_on\"));"
        }
      ]
    },
    {
      "name": "scheduled_notifications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scheduled_notifications\" (\"id\" INTEGER NOT NULL, \"day\" TEXT NOT NULL, \"fire_at\" TEXT NOT NULL, \"task_count\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
