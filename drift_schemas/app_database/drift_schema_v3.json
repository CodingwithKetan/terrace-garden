    {
      "name": "gardens",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gardens\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"space_type\" TEXT NOT NULL, \"city_name\" TEXT NULL, \"region\" TEXT NULL, \"length_cm\" REAL NULL, \"width_cm\" REAL NULL, \"sun\" TEXT NOT NULL, \"facing\" TEXT NOT NULL, \"wind\" TEXT NOT NULL, \"water\" TEXT NOT NULL, \"goals\" TEXT NOT NULL DEFAULT '', \"style\" TEXT NULL, \"experience\" TEXT NULL, \"weekly_time\" TEXT NOT NULL, \"budget\" TEXT NOT NULL, \"cover_photo_id\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "garden_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"garden_photos\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"relative_path\" TEXT NOT NULL, \"thumbnail_path\" TEXT NOT NULL, \"caption\" TEXT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"taken_at\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "layout_elements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"layout_elements\" (\"id\" TEXT NOT NULL, \"garden_id\" TEXT NOT NULL REFERENCES gardens (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"center_x\" REAL NOT NULL, \"center_y\" REAL NOT NULL, \"width\" REAL NOT NULL, \"height\" REAL NOT NULL, \"rotation_deg\" REAL NOT NULL DEFAULT 0.0, \"depth_cm\" REAL NULL, \"label\" TEXT NULL, \"z_index\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
